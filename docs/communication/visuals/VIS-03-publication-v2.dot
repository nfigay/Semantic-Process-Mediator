digraph G {graph [rankdir=LR,bgcolor="white",pad="0.3",fontname="Helvetica",label="Conserver, construire et publier : opérations distinctes",labelloc=t,fontsize=19];node [shape=box,style="rounded,filled",fillcolor="#eef4fb",color="#53677c",fontname="Helvetica",fontsize=11];edge [color="#61758a",fontname="Helvetica",fontsize=9];git [label="Git local\nHEAD + modifications"];gh [label="GitHub origin\nPush explicite"];ci [label="GitHub Actions\nCI : tests / build\n≠ déploiement",fillcolor="#fff1d9"];dist [label="Artefacts dist/\nContrôlés localement"];pub [label="Script de publication\nDécision et déploiement explicites",fillcolor="#fff1d9"];branch [label="Branche gh-pages"];pages [label="GitHub Pages"];check [label="HTTP / runtime\nPreuves distinctes",fillcolor="#e1f1e5"];git->gh;gh->ci;git->dist [label="Vite local"];dist->pub;pub->branch;branch->pages;pages->check;}