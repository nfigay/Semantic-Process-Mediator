digraph G {graph [rankdir=LR,bgcolor="white",pad="0.3",fontname="Helvetica",label="Fabriquer six distributions depuis une base de sources",labelloc=t,fontsize=19];node [shape=box,style="rounded,filled",fillcolor="#eef4fb",color="#53677c",fontname="Helvetica",fontsize=11];edge [color="#61758a"];sources [label="Sources communes\nRepository Git"];vite [label="Vite + scripts\nBuilds ciblés",fillcolor="#fff1d9"];stand [label="Standalone\nEditor / Viewer",fillcolor="#e1f1e5"];inter [label=".semarch-build/\nSorties intermédiaires",fillcolor="#fff1d9"];server [label="Server\nPublisher / Viewer",fillcolor="#e1f1e5"];modules [label="Modules\nPublisher / Viewer",fillcolor="#e1f1e5"];dist [label="dist/\nArtefacts assemblés",fillcolor="#dfeefa"];sources->vite;vite->stand;vite->inter;inter->server;inter->modules;stand->dist;server->dist;modules->dist;}