digraph G {graph [rankdir=LR,bgcolor="white",pad="0.4",fontname="Helvetica",label="Deux systèmes et une boucle d’apprentissage",labelloc=t,fontsize=21];node [shape=box,style="rounded,filled",fillcolor="#edf4fb",color="#51677c",fontname="Helvetica",fontsize=12];edge [color="#62798c",fontname="Helvetica",fontsize=10];human [label="Humain\nAutorise, exécute, décide"];ai [label="IA\nCodex : workspace contrôlé\nChatGPT : analyse et procédures"];tools [label="Contrats et outils\nDEPP/EDED • Git • Vite • Chrome"];bpmn [label="BPMNSM\nModèles BPMN + sémantique",fillcolor="#e4f5e8"];product [label="Éditeur / Viewer\nDistributions et versions",fillcolor="#e4f5e8"];evidence [label="Observations et preuves\nSuccès • écarts • limites",fillcolor="#fff1d9"];human->ai [label="délègue sous conditions"];ai->tools;tools->bpmn [label="prépare / contrôle"];bpmn->product;product->evidence;evidence->human [label="décision et adaptation"];human->tools [style=dashed,label="fait évoluer les règles",constraint=false];}