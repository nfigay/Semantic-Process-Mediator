{
  "name": "semantic-process-mediator",
  "version": "1.0.0",
  "type": "module",
  "description": "BPMN Process Mediator",
  "main": "main.js",
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build:viewer": "vite build --mode standalone-viewer",
    "build:editor": "vite build --mode standalone-editor",
    "build:pages": "vite build --mode pages",
    "build": "npm run build:viewer && npm run build:editor && npm run build:pages",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfigay/Semantic-Process-Mediator.git"
  },
  "keywords": [
    "BPMN;Mediator"
  ],
  "author": "Dr Nicolas Figay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nfigay/Semantic-Process-Mediator/issues"
  },
  "homepage": "https://github.com/nfigay/Semantic-Process-Mediator#readme",
  "dependencies": {
    "@bpmn-io/properties-panel": "^3.41.2",
    "bpmn-js": "^18.26.0",
    "bpmn-js-bpmnlint": "^0.24.0",
    "bpmn-js-properties-panel": "^5.54.0",
    "bpmnlint": "^11.13.0",
    "cytoscape": "^3.34.2",
    "d3": "^7.9.0",
    "i18next": "^26.0.8",
    "w2ui": "^2.0.0"
  },
  "devDependencies": {
    "bpmnlint-plugin-semarch": "file:src/linting/bpmnlint-plugin-semarch",
    "gh-pages": "^6.3.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}